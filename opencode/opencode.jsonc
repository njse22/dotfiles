{
	"$schema": "https://opencode.ai/config.json",
	"plugins": [
		"superpowers@git+https://github.com/obra/superpowers.git",
		"@dietrichgebert/ponytail",
		"egm@git+https://github.com/google/elephant-goldfish-model"
	],
	"formatter": true,
	"permissions": [
		{
			"action": "edit",
			"resource": "*",
			"effect": "ask"
		},
		{
			"action": "shell",
			"resource": "*",
			"effect": "ask"
		},
		{
			"action": "question",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "read",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "grep",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "skill",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "webfetch",
			"resource": "*",
			"effect": "allow"
		}
	],
	"providers": {
		"llama.cpp": {
			"name": "Llama.cpp (local)",
			"package": "aisdk:@ai-sdk/openai-compatible",
			"settings": {
				"baseURL": "http://localhost:8080/v1"
			},
			"models": {
				"Gemma-4-E4B": {
					"name": "Gemma 4 E4B"
				},
				"Llama-3.2-1B-Instruct-BF16": {
					"name": "Llama 3.2 1B"
				},
				"Qwen3.5-9B": {
					"name": "Qwen 3.5 9B"
				}
			}
		},
		"littlellm": {
			"name": "LittleLLM (Gemini)",
			"package": "aisdk:@ai-sdk/openai-compatible",
			"settings": {
				"baseURL": "http://localhost:4000/v1"
			},
			"models": {
				"smart-router": {
					"name": "Smart Router (auto)"
				},
				"gemini-pro": {
					"name": "Gemini Pro"
				},
				"gemini-flash": {
					"name": "Gemini Flash"
				}
			}
		},
		// Configuration for ollama
		// "ollama": {
		// 	"name": "Ollama (local)",
		// 	"package": "aisdk:@ai-sdk/openai-compatible",
		// 	"settings": {
		// 		"baseURL": "http://localhost:11434/v1"
		// 	},
		// 	"models": {
		// 		"gemma4:e4b": {
		// 			"name": "Gemma4 e4b"
		// 		},
		// 		"granite4.1:8b": {
		// 			"name": "Granite 4.1 8B"
		// 		},
		// 		"qwen3.5:9b": {
		// 			"name": "Qwen 3.5 9B"
		// 		}
		// 	}
		// }
	},
	"mcp": {
		"servers": {
			"context7": {
				"type": "remote",
				"url": "https://mcp.context7.com/mcp"
			},
			"playwright": {
				"type": "local",
				"command": [
					"npx",
					"-y",
					"@playwright/mcp@latest"
				]
			},
			// "GoogleWorkspace": {
			// 	"type": "remote",
			// 	"url": "https://github.com/gemini-cli-extensions/workspace"
			// },
		}
	}
}
