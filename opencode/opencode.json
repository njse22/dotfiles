{
	"$schema": "https://opencode.ai/config.json",
	"formatter": true,
	"permission": {
		"edit": "ask",
		"bash": "ask",
		"question": "allow",
		"read": "allow",
		"grep": "allow",
		"lsp": "allow",
		"skill": "allow",
		"todowrite": "allow",
		"webfetch": "allow"
	},
	"provider": {
		"llama.cpp": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Llama.cpp (local)",
			"options": {
				"baseURL": "http://localhost:8080/v1"
			},
			"models": {
				"Gemma-4-E4B": {
					"name": "Gemma 4 E4B"
				},
				"Llama-3.2-1B-Instruct-BF16": {
					"name": "Llama 3.2 1B"
				},
				"Qwen3.5-9B": {
					"name": "Qwen 3.5 9B"
				},
			}
		},
